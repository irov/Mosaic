@PACKAGE_INIT@

if(NOT TARGET Mosaic::GraphicsDependency)
    add_library(Mosaic::GraphicsDependency STATIC IMPORTED)
    set_target_properties(Mosaic::GraphicsDependency PROPERTIES
        IMPORTED_LOCATION "@PACKAGE_CMAKE_INSTALL_LIBDIR@/@MOSAIC_GRAPHICS_PACKAGE_LIBRARY@"
    )
endif()

include("${CMAKE_CURRENT_LIST_DIR}/MosaicTargets.cmake")
check_required_components(Mosaic)
